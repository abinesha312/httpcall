# Twilio Account Credentials
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio API Key (create at https://console.twilio.com/project/api-keys)
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret_here

# TwiML Application SID (create at https://console.twilio.com/develop/voice/manage/twiml-apps)
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Phone Number (buy at https://console.twilio.com/develop/phone-numbers/manage/incoming)
# This is the caller ID that will appear on outbound calls
TWILIO_FROM_NUMBER=+15551234567

# Public URL for webhooks (use ngrok for local development)
# Example: https://abc123.ngrok.io (no trailing slash)
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok.io
